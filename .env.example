LLM_PROVIDER=mock
OPENAI_API_KEY=
CHROMA_PATH=data/chroma
APP_DB_PATH=data/app.db
QUERY_TIMEOUT_S=5
ABSOLUTE_MAX_ROWS=10000
EMBEDDING_MODE=onnx
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
ADMIN_API_KEY=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MIN=60
LOG_FORMAT=text
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
# Analytics database. azure = Azure SQL (the product). memory = an in-memory TEST DOUBLE for tests, CI and offline demos only.
# Keep comments on their own line, never after a value.
ANALYTICS_BACKEND=azure
# Read-only Azure SQL login used by the app (replace every placeholder; never commit real values)
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DATABASE;Uid=YOUR_READONLY_USER;Pwd=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
# Admin login, used only by data/seed_azure.py to create and fill the demo tables
AZURE_SQL_ADMIN_CONNECTION_STRING=
# Seconds the discovered schema is cached (0 reloads on every question)
SCHEMA_CACHE_TTL_S=300
# /ready fails if the app's login has any write permission
REQUIRE_READ_ONLY_LOGIN=true
