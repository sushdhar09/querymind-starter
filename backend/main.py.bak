
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import sqlite3, os, time
from pathlib import Path
from components.query_classifier import classify_query
from components.schema_linker import link_schema
from components.example_retriever import retrieve_examples
from components.sql_generator import build_prompt, generate_sql
from components.sql_validator import validate_sql
from components.sql_executor import execute_sql
from components.result_formatter import format_results

# Robust DB path
BASE_DIR = Path(__file__).parent
DATA_DIR = BASE_DIR.parent / "data"
DB_PATH = DATA_DIR / "querymind.db"

print(f"Using DB at: {DB_PATH} - exists: {DB_PATH.exists()}")

app = FastAPI(title="QueryMind AI - Text-to-SQL Engine")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

class QueryRequest(BaseModel):
    nl_query: str
    dialect: str = "sqlite"
    max_rows: int = 100

class GuardrailConfig(BaseModel):
    max_rows: int = 100
    blocked_keywords: list = ["DROP","DELETE","UPDATE","INSERT"]
    allowed_tables_prefix: str = ""

guardrail_config = GuardrailConfig()

@app.get("/health")
def health(): 
    return {"status":"ok", "db_exists": DB_PATH.exists(), "db_path": str(DB_PATH)}

@app.post("/query")
def query(req: QueryRequest):
    start = time.time()
    try:
        c_out = classify_query(req.nl_query)
        if c_out.query_type=="UNSUPPORTED":
            return {"error":"Unsupported query type - destructive operations are blocked", "query_type": c_out.query_type}

        linker_out = link_schema(req.nl_query, c_out, db_path=str(DB_PATH))
        retrieved = retrieve_examples(req.nl_query, k=3)
        prompt = build_prompt(req.nl_query, linker_out, retrieved, dialect=req.dialect, limit=guardrail_config.max_rows, db_path=str(DB_PATH))
        # Use mock by default so it works without API keys
        gen_out = generate_sql(prompt, provider="mock")

        val_out = validate_sql(gen_out.sql, max_rows=guardrail_config.max_rows)
        if not val_out.valid:
            retry_prompt = prompt + f"\nPrevious attempt failed: {val_out.errors}. Fix it."
            gen_out = generate_sql(retry_prompt, provider="mock")
            val_out = validate_sql(gen_out.sql, max_rows=guardrail_config.max_rows)

        if not val_out.valid:
            return {"nl_query": req.nl_query, "generated_sql": gen_out.sql, "error": val_out.errors, "valid": False}

        exec_out = execute_sql(val_out.sanitized_sql, db_path=str(DB_PATH))
        fmt_out = format_results(exec_out, req.nl_query)

        # log
        try:
            conn = sqlite3.connect(str(DB_PATH))
            conn.execute("INSERT INTO query_logs(nl_query, generated_sql, status, latency_ms, row_count, error) VALUES (?,?,?,?,?,?)",
                         (req.nl_query, val_out.sanitized_sql, "success" if not exec_out.error else "error", exec_out.latency_ms, exec_out.row_count, exec_out.error))
            conn.commit(); conn.close()
        except Exception as e:
            print(f"Log failed: {e}")

        return {
            "nl_query": req.nl_query,
            "query_type": c_out.query_type,
            "resolved": linker_out.dict(),
            "few_shot_examples": retrieved['examples'],
            "generated_sql": val_out.sanitized_sql,
            "explanation": gen_out.explanation,
            "result": fmt_out.dict(),
            "execution": exec_out.dict(),
            "latency_total_ms": int((time.time()-start)*1000)
        }
    except Exception as e:
        import traceback
        traceback.print_exc()
        return {"error": str(e)}

# Admin APIs
@app.get("/admin/schema")
def get_schema():
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row
    tables = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").fetchall()
    result=[]
    for t in tables:
        cols = conn.execute(f"PRAGMA table_info({t['name']})").fetchall()
        result.append({"table": t['name'], "columns": [dict(c) for c in cols]})
    conn.close()
    return result

@app.get("/admin/examples")
def list_examples():
    conn = sqlite3.connect(str(DB_PATH))
    rows = conn.execute("SELECT * FROM few_shot_examples ORDER BY id DESC").fetchall()
    conn.close()
    return [{"id":r[0],"question":r[1],"sql":r[2],"query_type":r[3]} for r in rows]

@app.get("/admin/logs")
def get_logs(limit: int=100):
    conn = sqlite3.connect(str(DB_PATH))
    rows = conn.execute("SELECT * FROM query_logs ORDER BY timestamp DESC LIMIT ?", (limit,)).fetchall()
    conn.close()
    return [{"id":r[0],"nl_query":r[1],"generated_sql":r[2],"status":r[3],"latency_ms":r[4],"row_count":r[5],"error":r[6],"timestamp":r[7]} for r in rows]

@app.get("/admin/guardrails")
def get_guardrails(): return guardrail_config

# Run: uvicorn main:app --reload --port 8000
